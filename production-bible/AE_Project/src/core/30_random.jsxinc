/**
 * core/random — deterministic PRNG + loop-safe period/rate helpers.
 * Load order: 30. Depends on: core/namespace, core/config.
 *
 * All build-time variation flows through here so a re-run reproduces an identical project
 * (Mulberry32, seeded from SR.config.seed). loopPeriod/loopRate guarantee every sinusoidal
 * motion closes perfectly at frame 300. [Bible §8.4, §16.2, §22.2]
 */
(function (SR) {
    var Random = {
        _state: 0,

        /** (Re)seed the generator. Defaults to the configured build seed. */
        reset: function (seed) {
            this._state = ((seed == null ? SR.config.seed : seed) >>> 0);
        },

        /** Next float in [0,1). Mulberry32 — fast, deterministic, ES3-safe. */
        next: function () {
            this._state = (this._state + 0x6D2B79F5) >>> 0;
            var t = this._state;
            t = (typeof Math.imul === "function")
                ? Math.imul(t ^ (t >>> 15), t | 1)
                : (((t ^ (t >>> 15)) * (t | 1)) >>> 0);
            t = (t + ((((t ^ (t >>> 7)) >>> 0) * (t | 61)) >>> 0)) >>> 0;
            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        },

        /** Float in [a,b). */
        range: function (a, b) { return a + (b - a) * this.next(); },

        /** Integer in [a,b] inclusive. */
        int: function (a, b) { return Math.floor(this.range(a, b + 1)); },

        /**
         * Loop-safe period (seconds): returns durationSec / n, an exact divisor of the loop,
         * nearest a target in [minSec,maxSec]. Then sin(time*2*PI/period) closes at frame 300.
         */
        loopPeriod: function (minSec, maxSec) {
            var target = this.range(minSec, maxSec);
            var n = Math.max(1, Math.round(SR.config.comp.durationSec / target));
            return SR.config.comp.durationSec / n;
        },

        /** Loop-safe rate (cycles/sec): integer cycles over the loop -> rate*durationSec is integer. */
        loopRate: function (minCycles, maxCycles) {
            return this.int(minCycles, maxCycles) / SR.config.comp.durationSec;
        }
    };

    Random.reset();
    SR.Random = Random;
    SR.registerModule("core/random");
})($.global.SR);
